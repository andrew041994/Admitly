APP_NAME=Admitly API
APP_VERSION=1.0.0
ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/admitly
CORS_ALLOWED_ORIGINS=https://admitly.onrender.com,https://www.admitlyevents.com,https://admitlyevents.com
CORS_DEVELOPMENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MMG_ENABLED=false
MMG_PROVIDER_MODE=mock
MMG_BASE_URL=
MMG_MERCHANT_ID=
MMG_API_KEY=
MMG_API_SECRET=
MMG_CALLBACK_URL=
MMG_RETURN_URL_SUCCESS=
MMG_RETURN_URL_CANCEL=
MMG_REQUEST_TIMEOUT_SECONDS=10
MMG_AGENT_AUTO_VERIFY_ENABLED=true
MMG_AGENT_MANUAL_FALLBACK_ENABLED=true
ENABLE_DEV_TEST_CHECKOUT=false

# Required in production. The API refuses to start in production without Redis-backed limits.
REDIS_URL=
RATE_LIMIT_KEY_PREFIX=admitly:rate-limit
RATE_LIMIT_LOGIN_COUNT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_SIGNUP_COUNT=5
RATE_LIMIT_SIGNUP_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_COUNT=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=900

SENTRY_DSN=
# Optional explicit release; otherwise RENDER_GIT_COMMIT, then APP_VERSION is used.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

EMAIL_NOTIFICATIONS_ENABLED=false
# Recommended production provider: sendgrid. Supported: noop, mock, smtp, sendgrid.
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=
SENDGRID_API_KEY=
# Legacy SMTP settings are kept for backward compatibility, but are not recommended for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=https://admitly.app
APP_DEEP_LINK_BASE_URL=admitly://
PUSH_NOTIFICATIONS_ENABLED=false
# Supported: noop, mock, expo. Enabling Expo also requires the notification worker.
PUSH_PROVIDER=noop
RATE_LIMIT_PUSH_REGISTRATION_COUNT=10
RATE_LIMIT_PUSH_REGISTRATION_WINDOW_SECONDS=300
RATE_LIMIT_EVENT_COVER_UPLOAD_COUNT=10
RATE_LIMIT_EVENT_COVER_UPLOAD_WINDOW_SECONDS=300
RATE_LIMIT_VERIFICATION_DOCUMENT_UPLOAD_COUNT=3
RATE_LIMIT_VERIFICATION_DOCUMENT_UPLOAD_WINDOW_SECONDS=3600
TICKET_PUBLIC_BASE_URL=https://admitly.app

# Optional when the runtime supplies an AWS workload role. If one static-key
# variable is set, both must be set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_EVENT_BUCKET=admitly-assets-prod
S3_EVENT_PREFIX=event-covers/
S3_PUBLIC_BASE_URL=https://admitly-assets-prod.s3.us-east-2.amazonaws.com

# Private creator-verification storage. Keep disabled until the separate bucket,
# scoped runtime IAM policy, lifecycle rule, and access-denial checks pass.
VERIFICATION_DOCUMENT_UPLOAD_ENABLED=false
S3_VERIFICATION_BUCKET=
S3_VERIFICATION_REGION=us-east-2
S3_VERIFICATION_PREFIX=creator-verification/
# Optional. Leave blank to use the bucket's enforced SSE-S3 default.
S3_VERIFICATION_KMS_KEY_ID=
S3_VERIFICATION_MAX_BYTES=8388608
# Privacy backstop only; normal verify/reject processing deletes immediately.
S3_VERIFICATION_RETENTION_DAYS=7
VERIFICATION_DOCUMENT_CLEANUP_BATCH_SIZE=50


JWT_SECRET=dev-change-me
JWT_ACCESS_TOKEN_EXP_MINUTES=15
JWT_REFRESH_TOKEN_EXP_DAYS=30
AUTH_SESSION_RETENTION_DAYS=90
AUTH_SESSION_CLEANUP_BATCH_SIZE=100
VERIFICATION_TOKEN_EXP_HOURS=24
PASSWORD_RESET_TOKEN_EXP_MINUTES=60
